+// crew-codex turn requirements: native skill input and a network-capable
+// sandbox policy. CREW_CODEX_TURN_SPEC names a JSON file written by crew-codex
+// after it validated the skills; unset means stock behavior. A set-but-unusable
+// spec throws: silently running without the required skills or capability would
+// let a review proceed on an unmet requirement.
+function readCrewTurnSpec() {
+  const specPath = process.env.CREW_CODEX_TURN_SPEC;
+  if (!specPath) {
+    return null;
+  }
+  let spec;
+  try {
+    spec = JSON.parse(fs.readFileSync(specPath, "utf8"));
+  } catch (error) {
+    throw new Error(`crew-codex turn spec ${specPath} is unreadable: ${error.message}`);
+  }
+  const skills = Array.isArray(spec.skills) ? spec.skills : [];
+  for (const skill of skills) {
+    if (typeof skill?.name !== "string" || !skill.name || typeof skill?.path !== "string" || !skill.path) {
+      throw new Error(`crew-codex turn spec ${specPath} has a skill without name and path`);
+    }
+  }
+  return { specPath, skills, network: spec.network === true, resumeThread: typeof spec.resumeThread === "string" ? spec.resumeThread : null };
+}
+
 /** @returns {UserInput[]} */
-function buildTurnInput(prompt) {
-  return [{ type: "text", text: prompt, text_elements: [] }];
+function buildTurnInput(prompt, spec = null) {
+  const skills = spec?.skills ?? [];
+  const mentions = skills.map((skill) => `$${skill.name}`).join(" ");
+  const text = mentions ? `${mentions}\n\n${prompt}` : prompt;
+  return [
+    { type: "text", text, text_elements: [] },
+    ...skills.map((skill) => ({ type: "skill", name: skill.name, path: skill.path }))
+  ];
+}
+
+// Network is a sandbox-policy field, separate from file-write authority:
+// read-only stays read-only with networkAccess, and workspace-write is only
+// used when the task itself was launched with --write.
+function buildCrewSandboxPolicy(spec, write) {
+  if (!spec?.network) {
+    return null;
+  }
+  return write ? { type: "workspaceWrite", networkAccess: true } : { type: "readOnly", networkAccess: true };
 }
 
