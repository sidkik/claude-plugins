#!/usr/bin/env bash
# crew-codex — forward to the official codex plugin's companion runtime.
# Resolves the runtime through installed_plugins.json so version bumps of
# codex@openai-codex never break the crew agents.
set -euo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
INSTALLED_JSON="$CLAUDE_DIR/plugins/installed_plugins.json"
CODEX_PLUGIN_ID="codex@openai-codex"

if ! command -v node >/dev/null 2>&1; then
  echo "crew-codex: node is required (the codex companion runtime is a Node script)" >&2
  exit 1
fi

if [[ ! -f "$INSTALLED_JSON" ]]; then
  echo "crew-codex: $INSTALLED_JSON not found — install the official Codex plugin first: /plugin install $CODEX_PLUGIN_ID" >&2
  exit 1
fi

if ! COMPANION_ROOT="$(node -e '
  const fs = require("fs");
  const data = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  const entries = (data.plugins || {})[process.argv[2]];
  if (!Array.isArray(entries) || entries.length === 0 || !entries[0].installPath) process.exit(2);
  process.stdout.write(entries[0].installPath);
' "$INSTALLED_JSON" "$CODEX_PLUGIN_ID")"; then
  echo "crew-codex: $CODEX_PLUGIN_ID is not installed — run: /plugin install $CODEX_PLUGIN_ID" >&2
  exit 1
fi

COMPANION="$COMPANION_ROOT/scripts/codex-companion.mjs"
if [[ ! -f "$COMPANION" ]]; then
  echo "crew-codex: companion script missing at $COMPANION — the codex plugin layout changed; update codex-crew's resolver" >&2
  exit 1
fi

# Job state must land in the codex plugin's data dir so /codex:status,
# /codex:result and its SessionEnd cleanup see crew-launched jobs too.
export CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-$CLAUDE_DIR/plugins/data/codex-openai-codex}"

# Our own archive — the companion prunes at 50 jobs (deleting logs) and drops
# a session's jobs at SessionEnd, so results are copied somewhere it can't reap.
CREW_ARCHIVE_DIR="${CREW_CODEX_ARCHIVE_DIR:-$CLAUDE_DIR/plugins/data/codex-crew/jobs}"

# CREW_CODEX_TURN_SPEC is launcher-internal: this script sets it for the one
# companion process it starts. A value arriving from the environment belongs to
# the calling worker's own turn, so it must never decide this invocation's
# skills or network. Requirements come only from this invocation's flags or the
# job it resumes.
unset CREW_CODEX_TURN_SPEC

# ---- per-job brokers -------------------------------------------------------
# A broker carries ONE streaming turn per cwd. The companion's answer to a busy
# broker (lib/codex.mjs, withAppServer) is to run the whole job on a private
# stdio app-server, which has no socket, so nothing can ever steer, queue or
# interrupt it. In a shared cwd that means exactly one reachable job: whichever
# won the broker first. Everything launched during its turn is unreachable for
# life.
#
# So every launch gets its OWN broker and we remember the endpoint per job.
# CODEX_COMPANION_APP_SERVER_ENDPOINT takes priority over broker.json in the
# companion's own client, which is the seam this rides on.
#
# Brokers hold a codex app-server each, so a leak is expensive. Every one is
# recorded in a sidecar, reaped when its job reaches terminal state, and swept
# on the next launch plus `crew-codex reap`. A broker's SIGTERM handler closes
# its app-server child and removes its socket, so one signal is a clean stop.
CREW_BROKER_ENV="CODEX_COMPANION_APP_SERVER_ENDPOINT"
CREW_BROKER_SCRIPT="$COMPANION_ROOT/scripts/app-server-broker.mjs"

crew_sidecar() { printf '%s/%s.broker' "$CREW_ARCHIVE_DIR" "$1"; }

crew_job_endpoint() {
  local f; f="$(crew_sidecar "$1")"
  [[ -f "$f" ]] || return 0
  cut -f1 <"$f"
}

# A pid alone is not an identity: pids get recycled, and a sidecar can outlive
# its broker by hours. Field 22 of /proc/<pid>/stat is the process start time in
# clock ticks, which together with the pid is stable and unforgeable enough to
# prove we are signalling the same process we started. Without /proc (macOS),
# fall back to ps's start time, pinned to UTC and the C locale so spawn and reap
# agree whatever their environment, trimmed with spaces turned into '_' so the
# value stays one token in the tab-separated sidecar. It has one-second resolution.
crew_pid_starttime() {
  local pid="$1" start
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  start="$(awk '{ n = split($0, a, ") "); print a[n] }' "/proc/$pid/stat" 2>/dev/null \
    | awk '{ print $20 }' 2>/dev/null || true)"
  if [[ -z "$start" ]]; then
    start="$(TZ=UTC LC_ALL=C ps -o lstart= -p "$pid" 2>/dev/null \
      | awk 'NF { $1 = $1; gsub(/ /, "_"); print; exit }' 2>/dev/null || true)"
  fi
  [[ -z "$start" ]] || printf '%s\n' "$start"
}

# Liveness without locale-dependent kill messages: "ours" answers kill -0,
# "foreign" is alive but refuses it (EPERM, so not a broker we started), and
# "dead" is gone from the process table.
crew_pid_state() {
  if kill -0 "$1" 2>/dev/null; then
    echo ours
  elif [[ -n "$(ps -o pid= -p "$1" 2>/dev/null || true)" ]]; then
    echo foreign
  else
    echo dead
  fi
}

crew_broker_clean() {
  local dir="$1"
  if [[ -n "$dir" && -d "$dir" ]]; then
    rm -f "$dir/broker.sock" "$dir/broker.pid" "$dir/broker.log" 2>/dev/null || true
    rmdir "$dir" 2>/dev/null || true
  fi
}

# Return code for a broker that is alive but cannot be proven to be ours.
CREW_BROKER_DEFERRED=3

# Stop one broker and remove everything it left behind, but only after proving
# the pid is still the process recorded at spawn. Outcomes:
#   0  stopped, already dead, or confirmed to be another process (files
#      cleaned; another process is never signalled)
#   3  alive but unverifiable: no recorded start time, or the current one is
#      unreadable. Nothing is signalled or deleted, so the record survives for a
#      later sweep or a manual stop; callers must keep their sidecar.
# The identity is checked again before escalating TERM to KILL, because the pid
# can be recycled during the grace period.
crew_kill_broker() {
  local pid="$1" dir="$2" expect_start="${3:-}" state now_start i=0
  if ! [[ "$pid" =~ ^[0-9]+$ ]]; then
    crew_broker_clean "$dir"
    return 0
  fi
  state="$(crew_pid_state "$pid")"
  if [[ "$state" == dead ]]; then
    crew_broker_clean "$dir"
    return 0
  fi
  if [[ "$state" == foreign ]]; then
    echo "crew-codex: broker pid $pid now belongs to another user's process; cleaned its files without signalling" >&2
    crew_broker_clean "$dir"
    return 0
  fi
  if [[ -z "$expect_start" ]]; then
    echo "crew-codex: broker pid $pid left running: no start time was recorded, so it cannot be proven to be ours; its files and record are kept (stop it by hand once confirmed)" >&2
    return "$CREW_BROKER_DEFERRED"
  fi
  while :; do
    now_start="$(crew_pid_starttime "$pid")"
    if [[ -z "$now_start" ]]; then
      if [[ "$(crew_pid_state "$pid")" == dead ]]; then
        crew_broker_clean "$dir"
        return 0
      fi
      echo "crew-codex: broker pid $pid left running: its start time cannot be read, so it cannot be proven to be ours; its files and record are kept" >&2
      return "$CREW_BROKER_DEFERRED"
    fi
    if [[ "$now_start" != "$expect_start" ]]; then
      echo "crew-codex: broker pid $pid is now a different process (start $now_start, recorded $expect_start); cleaned its files without signalling" >&2
      crew_broker_clean "$dir"
      return 0
    fi
    # Verified. The first pass sends TERM; the second, after the grace period,
    # is the only route to KILL.
    if [[ $i -eq 0 ]]; then
      kill "$pid" 2>/dev/null || true
      while [[ $i -lt 20 ]] && kill -0 "$pid" 2>/dev/null; do
        sleep 0.1
        i=$((i + 1))
      done
      i=20
      kill -0 "$pid" 2>/dev/null || break
      continue
    fi
    kill -9 "$pid" 2>/dev/null || true
    break
  done
  crew_broker_clean "$dir"
  return 0
}

# Stop a broker that is still this shell's own unreaped child, before any start
# time exists: $! cannot name a recycled process while we still own it.
crew_stop_own_child() {
  local pid="$1" dir="$2" i=0
  kill "$pid" 2>/dev/null || true
  while [[ $i -lt 20 ]] && kill -0 "$pid" 2>/dev/null; do
    sleep 0.1
    i=$((i + 1))
  done
  kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  crew_broker_clean "$dir"
}

# Sweep: any recorded broker whose job is no longer running, plus any of our
# broker directories whose process is already gone.
crew_reap_brokers() {
  local f job pid dir endpoint status
  for f in "$CREW_ARCHIVE_DIR"/*.broker; do
    [[ -f "$f" ]] || continue
    job="$(basename "$f" .broker)"
    IFS=$'\t' read -r endpoint pid dir _cwd startt _rest <"$f" || true
    # "running" is not proof of life: a worker killed with the session leaves
    # the index saying running forever, and its broker with it. Require a live
    # worker process too, or the leak this whole sidecar exists to prevent just
    # moves to the crash path.
    meta="$(crew_job_meta "$job")"
    IFS=$'\037' read -r mfound status _mthread _mcwd _mmodel _meffort _mwrite _mnewest _mturn jobpid _mrest <<<"$meta"
    # An unreadable snapshot is usually the companion rewriting the file in
    # place, not a dead job, and reaping on it would cut a live job off for
    # good. But a crash mid-rewrite can leave it invalid forever, and skipping
    # forever leaks the broker, so count strikes and give up after a few.
    strikes_file="$f.unreadable"
    if [[ "$mfound" == "UNREADABLE" ]]; then
      # Age it by WALL CLOCK, not by sweep count: several sweeps can fire in the
      # same second (a fan-out of launches each sweeping first) and race through
      # a count while the companion is mid-rewrite, killing a live broker. The
      # file records when the record first read badly; it has to stay bad for a
      # while before we believe it.
      now="$(date +%s)"
      first="$now"
      if [[ -f "$strikes_file" ]]; then
        first="$(cat "$strikes_file" 2>/dev/null || echo "$now")"
        [[ "$first" =~ ^[0-9]+$ ]] || first="$now"
      else
        printf '%s' "$now" >"$strikes_file.tmp.$$" 2>/dev/null \
          && mv -f "$strikes_file.tmp.$$" "$strikes_file" 2>/dev/null || true
      fi
      if [[ $(( now - first )) -lt ${CREW_CODEX_UNREADABLE_SECS:-120} ]]; then
        continue
      fi
      # Unreadable continuously for the whole grace period: a crashed rewrite,
      # not a busy one. Release the broker rather than hold it forever.
    else
      rm -f "$strikes_file" 2>/dev/null || true
    fi
    if [[ "$status" == "running" || "$status" == "queued" ]]; then
      if [[ "$jobpid" =~ ^[0-9]+$ ]] && kill -0 "$jobpid" 2>/dev/null; then
        continue
      fi
    fi
    # A deferred (unverifiable) broker keeps its sidecar for a later sweep.
    if crew_kill_broker "$pid" "$dir" "$startt"; then
      rm -f "$f" "$f.unreadable" 2>/dev/null || true
    fi
  done
  local d
  for d in "${CREW_CODEX_BROKER_TMPDIR:-${TMPDIR:-/tmp}}"/crewb-*; do
    [[ -d "$d" ]] || continue
    if [[ -f "$d/broker.pid" ]]; then
      pid="$(cat "$d/broker.pid" 2>/dev/null || true)"
      if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        continue
      fi
    fi
    rm -f "$d/broker.sock" "$d/broker.pid" "$d/broker.log" 2>/dev/null || true
    rmdir "$d" 2>/dev/null || true
  done
  return 0
}

# ONE cleanup path for the whole script. An unpublished broker is unreferenced,
# so anything that exits before publication must kill it. Two rules learned the
# hard way: a second `trap ... EXIT` anywhere silently replaces an earlier one,
# so there is exactly one EXIT trap and it consults state instead of capturing
# it; and a signal handler that does not exit lets bash resume, which could
# publish a sidecar naming the broker it just killed.
CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START="" CREW_CLEANUP_CHILD=""

crew_cleanup() {
  if [[ -n "${CREW_CLEANUP_PID:-}" ]]; then
    local p="$CREW_CLEANUP_PID" d="$CREW_CLEANUP_DIR" st="$CREW_CLEANUP_START" own="${CREW_CLEANUP_CHILD:-}"
    CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START="" CREW_CLEANUP_CHILD=""
    if [[ -z "$st" && -n "$own" ]]; then
      # Interrupted between $! and recording its start time.
      crew_stop_own_child "$p" "$d"
    else
      # A deferral has already said why the broker was left running.
      crew_kill_broker "$p" "$d" "$st" || true
    fi
  fi
  rm -f "${TMP_OUT:-}" "${TMP_ERR:-}" 2>/dev/null || true
}

crew_arm_cleanup() {
  trap 'crew_cleanup' EXIT
  trap 'crew_cleanup; exit 130' INT
  trap 'crew_cleanup; exit 143' TERM
}

# Start a broker for one job. Socket paths live under a short tmp dir because a
# unix
# socket path is capped near 108 bytes and the plugin data dir can be deep.
# Sets CREW_SPAWNED_ENDPOINT/PID/DIR/START; returns 1 on failure.
#
# Deliberately NOT called through command substitution. A subshell owns $! only
# inside itself, so between spawning and returning, the parent knows nothing to
# clean up while the broker is already alive and disowned - a TERM in that
# window left it running forever. Ownership is handed to the cleanup path on
# the line after $!, before anything that can block.
crew_spawn_job_broker() {
  local cwd="$1" dir sock pid i=0
  CREW_SPAWNED_ENDPOINT="" CREW_SPAWNED_PID="" CREW_SPAWNED_DIR="" CREW_SPAWNED_START=""
  [[ -f "$CREW_BROKER_SCRIPT" ]] || return 1
  dir="$(mktemp -d "${CREW_CODEX_BROKER_TMPDIR:-${TMPDIR:-/tmp}}/crewb-XXXXXXXX" 2>/dev/null)" || return 1
  sock="$dir/broker.sock"
  if [[ ${#sock} -ge 100 ]]; then
    rmdir "$dir" 2>/dev/null || true
    return 1
  fi
  node "$CREW_BROKER_SCRIPT" serve --endpoint "unix:$sock" --cwd "$cwd" \
    --pid-file "$dir/broker.pid" >"$dir/broker.log" 2>&1 &
  pid=$!
  CREW_CLEANUP_CHILD=1 CREW_CLEANUP_PID="$pid" CREW_CLEANUP_DIR="$dir" CREW_CLEANUP_START=""
  CREW_CLEANUP_START="$(crew_pid_starttime "$pid")"
  if [[ -z "$CREW_CLEANUP_START" ]]; then
    # Without a start time the broker could never be verified, so it is never
    # published; stop it while it is still provably our own child.
    crew_stop_own_child "$pid" "$dir"
    CREW_CLEANUP_CHILD="" CREW_CLEANUP_PID="" CREW_CLEANUP_DIR=""
    echo "crew-codex: broker pid $pid has no readable start time, so it could not be recorded safely; stopped it and refused the spawn" >&2
    return 1
  fi
  CREW_CLEANUP_CHILD=""
  disown "$pid" 2>/dev/null || true
  while [[ $i -lt 100 ]]; do
    [[ -S "$sock" ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
    i=$((i + 1))
  done
  if [[ ! -S "$sock" ]]; then
    crew_kill_broker "$pid" "$dir" "$CREW_CLEANUP_START" || true
    CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    return 1
  fi
  CREW_SPAWNED_ENDPOINT="unix:$sock" CREW_SPAWNED_PID="$pid" CREW_SPAWNED_DIR="$dir"
  CREW_SPAWNED_START="$CREW_CLEANUP_START"
  return 0
}

# Publish ownership atomically. A truncating write can be read half-formed by a
# concurrent sweep; a rename cannot.
crew_publish_sidecar() {
  local job="$1" side tmp
  # A record without a start time could never authorise a signal.
  [[ -n "${CREW_SPAWNED_START:-}" ]] || return 1
  side="$(crew_sidecar "$job")"
  mkdir -p "$CREW_ARCHIVE_DIR" || return 1
  tmp="$side.tmp.$$"
  printf '%s\t%s\t%s\t%s\t%s\n' "$CREW_SPAWNED_ENDPOINT" "$CREW_SPAWNED_PID" \
    "$CREW_SPAWNED_DIR" "$PWD" "$CREW_SPAWNED_START" >"$tmp" || return 1
  mv -f "$tmp" "$side" || { rm -f "$tmp" 2>/dev/null || true; return 1; }
  return 0
}

# --resume-last resolves "newest job in this cwd" at the moment it runs, so a
# launch landing between redirect's check and its relaunch makes redirect resume
# the wrong thread - after it has already cancelled the intended one. A per-cwd
# lock closes that window for the calls that can create the race.
#
# Deliberately fails OPEN. A fleet running many jobs in one directory would be
# far worse off deadlocked than racy, so a missing flock or a wait timeout warns
# and proceeds instead of blocking the launch.
crew_lock_acquire() {
  command -v flock >/dev/null 2>&1 || return 0
  mkdir -p "$CREW_ARCHIVE_DIR" 2>/dev/null || return 0
  local key
  key="$(printf '%s' "$PWD" | md5sum 2>/dev/null | cut -c1-16)" || return 0
  [[ -n "$key" ]] || return 0
  exec 9>"$CREW_ARCHIVE_DIR/.launch-$key.lock" 2>/dev/null || return 0
  if ! flock -w "${CREW_CODEX_LOCK_WAIT:-60}" 9 2>/dev/null; then
    echo "crew-codex: timed out waiting for the per-cwd launch lock; proceeding without it (a concurrent launch could race a redirect)" >&2
  fi
  return 0
}

crew_lock_release() {
  exec 9>&- 2>/dev/null || true
}

# One remover, so a sidecar and its strike file never drift apart.
crew_drop_sidecar() {
  rm -f "$(crew_sidecar "$1")" "$(crew_sidecar "$1").unreadable" 2>/dev/null || true
}

# The companion keys job state to a hash of the shell's cwd, and Claude Code
# resets the cwd between Bash calls, so a job launched from one directory is
# invisible to a call made from another. Keying stays as it is; we just refuse
# to report a live job as gone. On "not found", probe the sibling state
# directories under the same parent and name the cwd to re-run from.
crew_cwd_hint() {
  local job="$1" f jcwd
  for f in "$CLAUDE_PLUGIN_DATA"/state/*/jobs/"$job".json; do
    [[ -f "$f" ]] || continue
    jcwd="$(node -e '
      const fs = require("fs");
      try {
        const j = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String((j.request && j.request.cwd) || j.workspaceRoot || ""));
      } catch (e) {}
    ' "$f" 2>/dev/null || true)"
    if [[ "$jcwd" == "$PWD" ]]; then continue; fi
    if [[ -n "$jcwd" ]]; then
      printf '; job exists under cwd %s; re-run from that directory' "$jcwd"
    else
      printf '; job exists in state dir %s; re-run from the directory it was launched from' \
        "$(dirname "$(dirname "$f")")"
    fi
    return 0
  done
  return 0
}

# One read of a job's state file, as 0x1f-separated fields:
#   FOUND|MISSING|UNREADABLE, status, threadId, cwd, model, effort, write,
#   newest-or-id, turnId, pid
#
# NOT tab-separated. Tab is IFS whitespace, so bash collapses runs of it and an
# empty column silently shifts every later field left: a review job has no
# model or effort, which used to land the turn id in the wrong variable. 0x1f
# is not IFS whitespace, so empty fields survive.
#
# UNREADABLE means the job file exists but did not parse, which happens while
# the companion rewrites it in place. It is deliberately distinct from MISSING
# so the reaper never mistakes a transient read for a dead job.
crew_job_meta() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [dataDir, jobId] = process.argv.slice(1);
    const stateRoot = path.join(dataDir, "state");
    const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
    const SEP = "\u001f";
    let dirs = [];
    let sawUnreadable = false;
    try { dirs = fs.readdirSync(stateRoot); } catch { }
    for (const d of dirs) {
      const jobsDir = path.join(stateRoot, d, "jobs");
      const file = path.join(jobsDir, `${jobId}.json`);
      if (!fs.existsSync(file)) continue;
      const job = read(file);
      if (!job) { sawUnreadable = true; continue; }
      const cwd = (job.request && job.request.cwd) || job.workspaceRoot || "";
      let newest = jobId, newestAt = "";
      for (const f of fs.readdirSync(jobsDir)) {
        if (!f.endsWith(".json")) continue;
        const other = read(path.join(jobsDir, f));
        if (!other || !String(other.id || "").startsWith("task-")) continue;
        const at = String(other.createdAt || "");
        if (at > newestAt) { newestAt = at; newest = other.id; }
      }
      const req = job.request || {};
      process.stdout.write([
        "FOUND", job.status || "?", job.threadId || "", cwd,
        req.model || "", req.effort || "", req.write ? "true" : "false",
        newest === jobId ? "newest" : newest, job.turnId || "", String(job.pid || "")
      ].join(SEP));
      process.exit(0);
    }
    process.stdout.write((sawUnreadable ? "UNREADABLE" : "MISSING") + SEP.repeat(9));
  ' "$CLAUDE_PLUGIN_DATA" "$1" 2>/dev/null || printf 'UNREADABLE\037\037\037\037\037\037\037\037\037'
}

# A redirect cancels the old job and resumes its Codex thread under a NEW job
# id. An agent still awaiting the old id would otherwise read that cancellation
# as failure, so name the successor: same threadId, created later.
crew_successor() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [dataDir, jobId] = process.argv.slice(1);
    const stateRoot = path.join(dataDir, "state");
    const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
    let dirs = [];
    try { dirs = fs.readdirSync(stateRoot); } catch { }
    for (const d of dirs) {
      const jobsDir = path.join(stateRoot, d, "jobs");
      const self = read(path.join(jobsDir, `${jobId}.json`));
      if (!self) continue;
      if (!self.threadId) process.exit(0);
      const mine = String(self.createdAt || "");
      let best = "", bestAt = "";
      for (const f of fs.readdirSync(jobsDir)) {
        if (!f.endsWith(".json") || f === `${jobId}.json`) continue;
        const other = read(path.join(jobsDir, f));
        if (!other || other.threadId !== self.threadId) continue;
        const at = String(other.createdAt || "");
        if (at > mine && at > bestAt) { bestAt = at; best = other.id; }
      }
      if (best) process.stdout.write(best);
      process.exit(0);
    }
  ' "$CLAUDE_PLUGIN_DATA" "$1" 2>/dev/null || true
}

if [[ "${1:-}" == "--resolve" ]]; then
  echo "$COMPANION"
  exit 0
fi

# ---- patch: teach the installed codex plugin to accept a queued message -----
# Every user installs their own copy of codex@openai-codex, at whatever version
# they happen to be on, so we carry the fix as a patch and apply it to the tree
# we resolve rather than pinning a version. Context matching (fuzz 3) absorbs
# the line drift between plugin releases; a release that moves the code out from
# under the patch fails loudly instead of half-applying.
CREW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CREW_PATCH_FILE="${CREW_CODEX_PATCH_FILE:-$CREW_ROOT/patches/codex-plugin-queue-passthrough.patch}"
# A second, independent patch: native skill input and network-capable sandbox
# policy on turn/start. It touches a different file, so a release that moves one
# seam still takes the other.
CREW_TURN_PATCH_FILE="${CREW_CODEX_TURN_PATCH_FILE:-$CREW_ROOT/patches/codex-plugin-turn-capabilities.patch}"
CREW_PATCH_FILES=("$CREW_PATCH_FILE" "$CREW_TURN_PATCH_FILE")

crew_patch_state_of() {
  # applied | appliable | stale
  if patch -p1 -R --dry-run -s -F3 -d "$COMPANION_ROOT" <"$1" >/dev/null 2>&1; then
    echo applied
  elif patch -p1 --dry-run -s -F3 -d "$COMPANION_ROOT" <"$1" >/dev/null 2>&1; then
    echo appliable
  else
    echo stale
  fi
}

if [[ "${1:-}" == "patch" ]]; then
  shift
  ACTION="status"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) ACTION="apply"; shift ;;
      --revert) ACTION="revert"; shift ;;
      --status) ACTION="status"; shift ;;
      *) shift ;;
    esac
  done

  if ! command -v patch >/dev/null 2>&1; then
    echo "crew-codex: GNU patch is required to manage the codex plugin patch" >&2
    exit 1
  fi
  for pf in "${CREW_PATCH_FILES[@]}"; do
    if [[ ! -f "$pf" ]]; then
      echo "crew-codex: patch file missing at $pf" >&2
      exit 1
    fi
  done

  PLUGIN_VERSION="$(basename "$COMPANION_ROOT")"
  n_applied=0 n_appliable=0 n_stale=0 stale_names=""
  for pf in "${CREW_PATCH_FILES[@]}"; do
    case "$(crew_patch_state_of "$pf")" in
      applied)   n_applied=$((n_applied + 1)) ;;
      appliable) n_appliable=$((n_appliable + 1)) ;;
      *)         n_stale=$((n_stale + 1)); stale_names="$stale_names $(basename "$pf")" ;;
    esac
  done

  case "$ACTION" in
    status)
      if [[ $n_stale -gt 0 ]]; then
        echo "crew-codex: patch does not apply to codex plugin $PLUGIN_VERSION at $COMPANION_ROOT (stale:$stale_names) — the upstream code moved; re-cut the named patch in patches/" >&2
        exit 1
      elif [[ $n_appliable -gt 0 ]]; then
        echo "UNPATCHED | codex plugin $PLUGIN_VERSION applies cleanly; run: crew-codex patch --apply"
        exit 10
      fi
      echo "PATCHED | codex plugin $PLUGIN_VERSION at $COMPANION_ROOT"
      exit 0
      ;;
    apply)
      if [[ $n_appliable -eq 0 && $n_stale -eq 0 ]]; then
        echo "PATCHED | codex plugin $PLUGIN_VERSION was already patched; nothing to do"
        exit 0
      fi
      # Each patch stands alone: apply every one that fits, then fail loudly for
      # any that does not, so one moved seam never blocks the other fix.
      for pf in "${CREW_PATCH_FILES[@]}"; do
        [[ "$(crew_patch_state_of "$pf")" == "appliable" ]] || continue
        if ! patch -p1 -s -F3 -b --suffix=.crew-orig -d "$COMPANION_ROOT" <"$pf"; then
          echo "crew-codex: applying $(basename "$pf") failed partway; restore from the .crew-orig backups in $COMPANION_ROOT" >&2
          exit 1
        fi
        if [[ "$(crew_patch_state_of "$pf")" != "applied" ]]; then
          echo "crew-codex: $(basename "$pf") reported success but verification failed; inspect $COMPANION_ROOT" >&2
          exit 1
        fi
      done
      if [[ $n_stale -gt 0 ]]; then
        echo "crew-codex: patch does not apply to codex plugin $PLUGIN_VERSION at $COMPANION_ROOT (stale:$stale_names) — refusing to half-apply; re-cut the named patch against this version" >&2
        exit 1
      fi
      echo "PATCHED | codex plugin $PLUGIN_VERSION | backups: *.crew-orig | brokers already running keep the old code until their job ends"
      exit 0
      ;;
    revert)
      if [[ $n_applied -eq 0 ]]; then
        echo "UNPATCHED | codex plugin $PLUGIN_VERSION is not patched; nothing to revert"
        exit 0
      fi
      for pf in "${CREW_PATCH_FILES[@]}"; do
        [[ "$(crew_patch_state_of "$pf")" == "applied" ]] || continue
        if ! patch -p1 -R -s -F3 -d "$COMPANION_ROOT" <"$pf"; then
          echo "crew-codex: reverting $(basename "$pf") failed; restore from the .crew-orig backups in $COMPANION_ROOT" >&2
          exit 1
        fi
      done
      echo "UNPATCHED | codex plugin $PLUGIN_VERSION restored"
      exit 0
      ;;
  esac
fi

# ---- turn requirements: native skills and network capability ---------------
# `task --skill <name>` (repeatable) invokes the skill through Codex's native
# structured skill input; `task --network` lets the worker's sandbox reach the
# network (authenticated GitHub reads, package fetches) without granting file
# writes. File-write authority stays with `--write`. Both ride a per-job spec
# file named by CREW_CODEX_TURN_SPEC, read by the turn-capabilities patch.
# The spec holds skill names, discovered paths and one boolean; no secrets.
#
# Native `review`/`adversarial-review` (review/start) take no skill input, so
# they refuse these flags rather than run without the requirement.
crew_turn_sidecar() { printf '%s/%s.turn' "$CREW_ARCHIVE_DIR" "$1"; }

crew_turn_patch_ready() {
  [[ "$(crew_patch_state_of "$CREW_TURN_PATCH_FILE")" == "applied" ]]
}

# Fields of a spec file. A spec that cannot be read is an error, never "no
# requirements": the caller is continuing a thread that required something.
# Names print as REQUESTED (plugin-qualified when the launch qualified them), so
# a continuation resolves the same source again instead of whatever matches the
# bare name today.
crew_spec_names() {
  node -e '
    const s = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    for (const k of s.skills || []) console.log(k.requested || k.name);
  ' "$1"
}
crew_spec_network() {
  node -e '
    const s = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    console.log(s.network === true ? "true" : "false");
  ' "$1"
}

# The task job the companion recorded for a thread: the newest by updatedAt (a
# resume adds a job to its thread; the one just finished is the latest).
crew_thread_job() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [dataDir, thread] = process.argv.slice(1);
    const stateRoot = path.join(dataDir, "state");
    let best = null, bestAt = "";
    let dirs = []; try { dirs = fs.readdirSync(stateRoot); } catch {}
    for (const d of dirs) {
      const jobsDir = path.join(stateRoot, d, "jobs");
      let files = []; try { files = fs.readdirSync(jobsDir); } catch {}
      for (const f of files) {
        if (!f.endsWith(".json")) continue;
        let j; try { j = JSON.parse(fs.readFileSync(path.join(jobsDir, f), "utf8")); } catch { continue; }
        if (!j || j.jobClass !== "task" || j.threadId !== thread) continue;
        const at = String(j.updatedAt || j.createdAt || "");
        if (best === null || at > bestAt) { best = j.id; bestAt = at; }
      }
    }
    if (best) process.stdout.write(best);
  ' "$CLAUDE_PLUGIN_DATA" "$1" 2>/dev/null || true
}

# The job a --resume-last launch will continue. The companion owns that choice
# (session preference, failed jobs without a thread skipped), so ask its own
# resume-candidate command rather than re-deriving it. Prints the job id, or
# and thread id (tab separated), or nothing when the companion has no tracked task to resume. A companion that
# cannot answer is an error: guessing could continue under the wrong requirements.
crew_resume_job() {
  local answer
  if ! answer="$(node "$COMPANION" task-resume-candidate --json --cwd "$1" 2>&1)"; then
    echo "crew-codex: cannot determine which task --resume-last continues: $answer" >&2
    return 1
  fi
  printf '%s' "$answer" | node -e '
    let j; try { j = JSON.parse(require("fs").readFileSync(0, "utf8")); } catch { process.exit(3); }
    if (!j || typeof j.available !== "boolean") process.exit(3);
    if (j.available) process.stdout.write(String(j.candidate && j.candidate.id || "") + "\t" + String(j.candidate && j.candidate.threadId || ""));
  ' || { echo "crew-codex: task-resume-candidate gave an unreadable answer: $answer" >&2; return 1; }
}

# The spec file a job was launched with. Prints its path; nothing when the job
# carried no requirements. A recorded spec that is missing or unreadable is an
# error rather than a silent drop of the requirements.
crew_job_spec() {
  local side spec
  side="$(crew_turn_sidecar "$1")"
  [[ -f "$side" ]] || return 0
  spec="$(cat "$side")"
  if [[ -z "$spec" || ! -f "$spec" ]] || ! node -e 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' "$spec" 2>/dev/null; then
    echo "crew-codex: job $1 recorded required skills/capabilities in $side, but the spec ${spec:-<empty>} is missing or unreadable; refusing to continue without them (relaunch with explicit --skill/--network, or --no-requirements to drop them)" >&2
    return 1
  fi
  printf '%s' "$spec"
}

# Validate the skills at the worker cwd and write the spec. Sets CREW_TURN_SPEC_FILE.
#   crew_prepare_turn_spec <cwd> <network true|false> [skill ...]
# Any problem is printed and returns 1 BEFORE a job exists, so nothing dependent
# on the requirement runs.
crew_prepare_turn_spec() {
  local cwd="$1" network="$2" resolved names_json; shift 2
  CREW_TURN_SPEC_FILE=""
  if ! crew_turn_patch_ready; then
    echo "crew-codex: --skill/--network need the turn-capabilities patch on the codex plugin, which is not applied; run: crew-codex patch --apply" >&2
    return 1
  fi
  resolved="[]"
  if [[ $# -gt 0 ]]; then
    names_json="$(printf '%s\n' "$@" | node -e '
      const lines = require("fs").readFileSync(0, "utf8").split("\n").filter(Boolean);
      process.stdout.write(JSON.stringify(lines));
    ')"
    if ! resolved="$(printf '%s' "$names_json" | node "$CREW_ROOT/lib/appserver-cli.mjs" \
        skills-resolve "$COMPANION_ROOT" "$cwd" 2>&1)"; then
      echo "crew-codex: required skills cannot be invoked natively at $cwd; no job was started:" >&2
      echo "$resolved" >&2
      return 1
    fi
  fi
  mkdir -p "$CREW_ARCHIVE_DIR" || return 1
  CREW_TURN_SPEC_FILE="$(umask 077; mktemp "$CREW_ARCHIVE_DIR/spec-XXXXXXXX.turn.json")" || return 1
  if [[ -n "${CREW_SPEC_RESUME_THREAD:-}" ]]; then
    printf '{"skills":%s,"network":%s,"resumeThread":"%s"}\n' "$resolved" "$network" "$CREW_SPEC_RESUME_THREAD" >"$CREW_TURN_SPEC_FILE"
  else
    printf '{"skills":%s,"network":%s}\n' "$resolved" "$network" >"$CREW_TURN_SPEC_FILE"
  fi
  return 0
}

# ---- steer: interject into the turn a job is running right now --------------
# The primary way to correct a job in flight. Unlike interrupt, this stops
# nothing: the tool call in progress finishes, and the model reads the message
# at its next step, so it can change course before it has done all the wrong
# work. Verified: a job told to stop at file 9 of 20 read the message and
# stopped at 16, reporting "I had created exactly 16 iota files when I read
# your message." Requires the codex plugin patch (crew-codex patch --apply).
if [[ "${1:-}" == "steer" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: steer needs a job id — usage: crew-codex steer <job-id> \"<message>\"" >&2
    exit 2
  fi
  shift
  MESSAGE="$*"
  if [[ -z "$MESSAGE" ]]; then
    echo "crew-codex: steer needs the message text — usage: crew-codex steer <job-id> \"<message>\"" >&2
    exit 2
  fi

  # Name EVERY field and keep a trailing catch-all: `read` hands the unconsumed
  # remainder, tab separators included, to its last variable, so a short list
  # silently glues later fields onto it.
  IFS=$'\037' read -r jfound jstatus jthread jcwd _m _e _w _n jturn _jpid _rest <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run steer from that directory" >&2
    exit 2
  fi
  if [[ "$jstatus" != "running" ]]; then
    echo "crew-codex: job $JOB_ID is $jstatus, so there is no live turn to steer; use crew-codex queue to leave a message for its next turn" >&2
    exit 2
  fi
  if [[ -z "$jthread" || -z "$jturn" ]]; then
    echo "crew-codex: job $JOB_ID has not started a turn yet; try again in a moment" >&2
    exit 2
  fi

  steer_ep="$(crew_job_endpoint "$JOB_ID")"
  if [[ -n "$steer_ep" ]]; then
    export CODEX_COMPANION_APP_SERVER_ENDPOINT="$steer_ep"
  else
    echo "crew-codex: no broker recorded for $JOB_ID (launched before per-job brokers, or by another tool); it may be running on a private app-server that nothing can reach" >&2
  fi

  src=0
  steered="$(printf '%s' "$MESSAGE" | node "$CREW_ROOT/lib/appserver-cli.mjs" \
    steer "$COMPANION_ROOT" "$PWD" "$jthread" "$jturn" 2>&1)" || src=$?
  if [[ $src -ne 0 ]]; then
    echo "crew-codex: steering failed: $steered" >&2
    if grep -qiE "busy|experimentalApi" <<<"$steered"; then
      echo "crew-codex: that is the unpatched codex plugin refusing to steer — run: crew-codex patch --apply" >&2
    elif grep -qiE "no active turn|expected active turn|ExpectedTurnMismatch|not steerable" <<<"$steered"; then
      echo "crew-codex: the turn ended or moved on; use crew-codex queue to leave a message for the next one" >&2
    fi
    exit 1
  fi

  echo "STEERED $JOB_ID | thread $jthread | turn $jturn | the agent reads it at its next step; its reply lands in this job's own result"
  exit 0
fi

# ---- queue: say something to a running job without stopping it --------------
# The non-destructive way to change a job's course. The message waits; the
# agent reads it when it finishes the turn it is already running, so a job
# halfway through a multi-file edit lands that edit first. This is how a person
# redirects an agent, and it is the default: `redirect` interrupts, and an
# interrupt mid-edit leaves the tree half-written.
# Requires the codex plugin patch (crew-codex patch --apply).
if [[ "${1:-}" == "queue" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: queue needs a job id — usage: crew-codex queue <job-id> \"<message>\"" >&2
    exit 2
  fi
  shift
  MESSAGE="$*"
  if [[ -z "$MESSAGE" ]]; then
    echo "crew-codex: queue needs the message text — usage: crew-codex queue <job-id> \"<message>\"" >&2
    exit 2
  fi

  IFS=$'\037' read -r jfound jstatus jthread jcwd _jmodel _jeffort _jwrite _jnewest _jturn _jpid _rest <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run queue from that directory" >&2
    exit 2
  fi
  if [[ -z "$jthread" ]]; then
    echo "crew-codex: job $JOB_ID has no Codex thread yet; wait for it to start before queueing" >&2
    exit 2
  fi
  if [[ "$jstatus" != "running" && "$jstatus" != "queued" ]]; then
    echo "crew-codex: job $JOB_ID is $jstatus, so a queued message would never be read; resume the thread instead (crew-codex redirect, or task --resume-last)" >&2
    exit 2
  fi

  queue_ep="$(crew_job_endpoint "$JOB_ID")"
  if [[ -n "$queue_ep" ]]; then
    export CODEX_COMPANION_APP_SERVER_ENDPOINT="$queue_ep"
  else
    echo "crew-codex: no broker recorded for $JOB_ID (launched before per-job brokers, or by another tool); it may be running on a private app-server that nothing can reach" >&2
  fi

  mkdir -p "$CREW_ARCHIVE_DIR"
  seq_file="$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt"
  next=1
  if [[ -f "$seq_file" ]]; then
    next=$(( $(wc -l <"$seq_file") + 1 ))
  fi
  CLIENT_ID="crew-$JOB_ID-$next"

  qrc=0
  submission="$(printf '%s' "$MESSAGE" | node "$CREW_ROOT/lib/appserver-cli.mjs" \
    queue-add "$COMPANION_ROOT" "$PWD" "$jthread" "$CLIENT_ID" 2>&1)" || qrc=$?
  if [[ $qrc -ne 0 ]]; then
    echo "crew-codex: queueing failed: $submission" >&2
    if grep -qiE "busy|experimentalApi" <<<"$submission"; then
      echo "crew-codex: that is the unpatched codex plugin refusing a queued message — run: crew-codex patch --apply" >&2
    fi
    exit 1
  fi

  printf '%s\t%s\n' "$CLIENT_ID" "$MESSAGE" >>"$seq_file"
  echo "QUEUED $JOB_ID | thread $jthread | id $CLIENT_ID | the agent reads it when its current turn ends; keep awaiting"
  exit 0
fi

# ---- redirect: put a running job onto new instructions, keeping its thread --
# Codex itself can steer a turn in flight (turn/steer), but the codex plugin's
# broker forwards exactly ONE method while a turn streams: turn/interrupt
# (app-server-broker.mjs). So mid-turn steering is not reachable from here, and
# `codex queue` writes to a queue a crew job never drains. What IS reachable is
# interrupt-then-resume: cancel stops the live turn, and --resume-last picks the
# same Codex thread back up with the work so far still in context. Verified: a
# job cancelled after 4 of 30 files resumed knowing it had made exactly 4.
if [[ "${1:-}" == "redirect" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: redirect needs a job id — usage: crew-codex redirect <job-id> [--model <m>] [--effort <e>] \"<instruction>\"" >&2
    exit 2
  fi
  shift

  R_MODEL="" R_EFFORT="" INSTRUCTION=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) R_MODEL="${2:-}"; shift 2 ;;
      --effort) R_EFFORT="${2:-}"; shift 2 ;;
      *) INSTRUCTION="${INSTRUCTION:+$INSTRUCTION }$1"; shift ;;
    esac
  done

  if [[ -z "$INSTRUCTION" ]]; then
    echo "crew-codex: redirect needs the new instruction text — usage: crew-codex redirect <job-id> \"<instruction>\"" >&2
    exit 2
  fi

  # --resume-last resumes the newest task thread for THIS cwd, so the job being
  # redirected has to be that newest job or we would silently steer another one.
  IFS=$'\037' read -r jfound jstatus jthread jcwd jmodel jeffort jwrite jnewest _jturn _jpid _rest <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run redirect from that directory so --resume-last targets its thread" >&2
    exit 2
  fi
  if [[ "$jnewest" != "newest" ]]; then
    echo "crew-codex: job $JOB_ID is not the newest task job for this cwd ($jnewest is); redirect resumes the newest thread, so cancel and re-dispatch explicitly instead" >&2
    exit 2
  fi

  # The successor keeps the old job's skill and network requirements. Validate
  # them again here, before the destructive step: a skill that vanished since
  # launch must stop the redirect, not the relaunched turn.
  RED_SPEC_FILE=""
  old_spec="$(crew_job_spec "$JOB_ID")" || { echo "crew-codex: not redirecting $JOB_ID" >&2; exit 1; }
  if [[ -n "$old_spec" ]]; then
    red_names_out="$(crew_spec_names "$old_spec")" && red_net="$(crew_spec_network "$old_spec")" \
      || { echo "crew-codex: not redirecting $JOB_ID; its recorded requirements are unreadable" >&2; exit 1; }
    red_names=(); [[ -n "$red_names_out" ]] && mapfile -t red_names <<<"$red_names_out"
    [[ "$jthread" =~ ^[A-Za-z0-9._-]+$ ]] && CREW_SPEC_RESUME_THREAD="$jthread"
    if ! crew_prepare_turn_spec "$PWD" "$red_net" "${red_names[@]}"; then
      echo "crew-codex: not redirecting $JOB_ID; its required skills/capabilities cannot be re-established" >&2
      exit 1
    fi
    RED_SPEC_FILE="$CREW_TURN_SPEC_FILE"
  fi

  # Order matters. Cancelling destroys the old turn, so nothing irreversible
  # happens until the successor's broker exists: allocating it afterwards meant
  # an allocation failure left the turn destroyed AND the successor on an
  # unreachable private app-server, the exact failure this release prevents.
  old_ep="$(crew_job_endpoint "$JOB_ID")"
  RED_PID="" RED_DIR="" RED_EP="" RED_START=""
  if [[ -z "${CREW_CODEX_NO_JOB_BROKER:-}" ]]; then
    if crew_spawn_job_broker "$PWD"; then
      RED_EP="$CREW_SPAWNED_ENDPOINT" RED_PID="$CREW_SPAWNED_PID"
      RED_DIR="$CREW_SPAWNED_DIR" RED_START="$CREW_SPAWNED_START"
      crew_arm_cleanup
    else
      echo "crew-codex: could not start a broker for the successor; leaving $JOB_ID running rather than cancelling it and relaunching somewhere unreachable" >&2
      exit 1
    fi
  fi

  # Hold the per-cwd lock from here until the successor exists, so no launch can
  # slip in and become "newest" between the check and the relaunch.
  crew_lock_acquire

  # Re-check under the lock, right before the destructive step.
  IFS=$'\037' read -r _rf _rs _rt _rc _rm _re _rw rnewest _rturn _rpid _rrest <<<"$(crew_job_meta "$JOB_ID")"
  if [[ "$rnewest" != "newest" ]]; then
    echo "crew-codex: $JOB_ID stopped being the newest job for this cwd ($rnewest launched since); not cancelling it, re-run the redirect against the newest job" >&2
    crew_lock_release
    exit 2
  fi

  if [[ "$jstatus" == "running" || "$jstatus" == "queued" ]]; then
    crc=0
    cancel_out="$(CODEX_COMPANION_APP_SERVER_ENDPOINT="${old_ep:-${CODEX_COMPANION_APP_SERVER_ENDPOINT:-}}" \
      node "$COMPANION" cancel "$JOB_ID" 2>&1)" || crc=$?
    if [[ $crc -ne 0 ]]; then
      echo "crew-codex: cancelling $JOB_ID failed, so the old turn may still be running; refusing to start a second one on the same thread" >&2
      echo "$cancel_out" >&2
      exit 1
    fi
    echo "crew-codex: interrupted $JOB_ID (was $jstatus)"
  else
    echo "crew-codex: $JOB_ID was already $jstatus; resuming its thread"
  fi

  # The old job is finished, so retire its broker and give the successor its
  # own. Without this the resumed job falls back to a private app-server and is
  # unreachable, which is the whole failure this release exists to fix.
  old_side="$(crew_sidecar "$JOB_ID")"
  if [[ -f "$old_side" ]]; then
    IFS=$'\t' read -r _oe obpid obdir _ocwd obstart _orest <"$old_side" || true
    # Deferred: keep the old record; the successor still gets its own broker.
    if crew_kill_broker "$obpid" "$obdir" "$obstart"; then
      crew_drop_sidecar "$JOB_ID"
    fi
  fi
  unset CODEX_COMPANION_APP_SERVER_ENDPOINT
  if [[ -n "$RED_EP" ]]; then
    export CODEX_COMPANION_APP_SERVER_ENDPOINT="$RED_EP"
  fi

  [[ -n "$RED_SPEC_FILE" ]] && export CREW_CODEX_TURN_SPEC="$RED_SPEC_FILE"
  relaunch=(task --background --resume-last)
  [[ "$jwrite" == "true" ]] && relaunch+=(--write)
  use_model="${R_MODEL:-$jmodel}"
  use_effort="${R_EFFORT:-$jeffort}"
  [[ -n "$use_model" ]] && relaunch+=(--model "$use_model")
  [[ -n "$use_effort" ]] && relaunch+=(--effort "$use_effort")
  relaunch+=("$INSTRUCTION")

  rrc=0
  relaunch_out="$(node "$COMPANION" "${relaunch[@]}" 2>&1)" || rrc=$?
  echo "$relaunch_out"
  if [[ $rrc -ne 0 ]]; then
    echo "crew-codex: redirect relaunch failed (exit $rrc); the thread is intact — resume it manually with --resume-last" >&2
    exit $rrc
  fi

  NEW_ID="$(grep -oE '\b(task|review)-[a-z0-9]+-[a-z0-9]+\b' <<<"$relaunch_out" | head -1 || true)"
  if [[ -n "$RED_SPEC_FILE" ]]; then
    if [[ -n "$NEW_ID" ]]; then
      printf '%s\n' "$RED_SPEC_FILE" >"$(crew_turn_sidecar "$NEW_ID")"
    else
      rm -f "$RED_SPEC_FILE" 2>/dev/null || true
    fi
  fi
  if [[ -n "$RED_PID" ]]; then
    if [[ -n "$NEW_ID" ]]; then
      if ! crew_publish_sidecar "$NEW_ID"; then
        # The successor is already running; killing its broker would strand it.
        echo "crew-codex: successor $NEW_ID started but its broker could not be recorded; steer/queue will not route to it (endpoint $RED_EP)" >&2
      fi
      RED_PID="" CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    else
      crew_kill_broker "$RED_PID" "$RED_DIR" "$RED_START" || true
      RED_PID="" CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    fi
  fi
  crew_lock_release
  echo "REDIRECTED $JOB_ID -> ${NEW_ID:-<unknown>} | thread ${jthread:-<pending>} | await the NEW id"
  exit 0
fi

# ---- await: poll a detached job toward terminal state, token-free ----------
# Claude Code's Bash tool caps a single call at 600s, but codex jobs run for
# hours. Each await call blocks up to --for seconds (default 540, safely under
# that cap) and prints exactly ONE line; the caller loops until it stops
# reporting RUNNING. Polling happens in-shell, so a multi-hour job costs no
# model tokens while it runs. Exit: 0 completed, 1 failed/cancelled,
# 2 job not found, 3 stale, 4 superseded by a redirect, 10 still running.
if [[ "${1:-}" == "await" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: await needs a job id — usage: crew-codex await <job-id> [--for <seconds>]" >&2
    exit 2
  fi
  shift

  FOR_SECS=540
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --for) FOR_SECS="${2:-540}"; shift 2 ;;
      *) shift ;;
    esac
  done
  POLL_SECS="${CREW_CODEX_POLL_SECS:-5}"

  # Talk to the broker this job actually runs on, not whichever one the cwd's
  # broker.json happens to name right now.
  await_ep="$(crew_job_endpoint "$JOB_ID")"
  [[ -n "$await_ep" ]] && export CODEX_COMPANION_APP_SERVER_ENDPOINT="$await_ep"

  deadline=$(( $(date +%s) + FOR_SECS ))
  missing_streak=0
  stale_streak=0

  while :; do
    snap="$(node "$COMPANION" status "$JOB_ID" --json 2>/dev/null || true)"
    parsed="$(printf '%s' "$snap" | python3 -c '
import json, sys
try:
    j = json.load(sys.stdin)["job"]
except Exception:
    print("MISSING\t-\t-\t-\t-")
    raise SystemExit
p = j.get("progressPreview") or []
last = str(p[-1]) if p else "-"
print("\t".join([
    str(j.get("status", "?")),
    str(j.get("elapsed", "?")),
    str(j.get("logFile", "-")),
    last.replace("\t", " ")[:80],
    str(j.get("pid") or "-"),
]))
' 2>/dev/null || printf 'MISSING\t-\t-\t-\t-')"
    IFS=$'\t' read -r jstatus jelapsed jlog jlast jpid <<<"$parsed"

    case "$jstatus" in
      queued|running)
        missing_streak=0
        ;;
      completed|failed|cancelled)
        mkdir -p "$CREW_ARCHIVE_DIR"
        node "$COMPANION" result "$JOB_ID" >"$CREW_ARCHIVE_DIR/$JOB_ID.result.txt" 2>/dev/null || true
        node "$COMPANION" result "$JOB_ID" --json >"$CREW_ARCHIVE_DIR/$JOB_ID.meta.json" 2>/dev/null || true
        if [[ -f "$jlog" ]]; then
          cp -f "$jlog" "$CREW_ARCHIVE_DIR/$JOB_ID.log" 2>/dev/null || true
        fi
        # The companion closes the job at the FIRST turn/completed, so a turn
        # started from a queued message finishes outside the job record. Pull
        # those replies off the thread and append them, or the queued
        # instruction succeeds invisibly.
        if [[ -s "$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt" ]]; then
          IFS=$'\037' read -r _qf _qs qthread _qrest <<<"$(crew_job_meta "$JOB_ID")"
          if [[ -n "$qthread" ]]; then
            # The job reports terminal the moment its FIRST turn ends, which is
            # before the queued turn has run. Wait for the replies we know were
            # queued rather than racing them, but stay bounded: a queued turn
            # can be lost if the worker tears down first.
            expected=$(wc -l <"$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt")
            grace_deadline=$(( $(date +%s) + ${CREW_CODEX_QUEUE_GRACE_SECS:-180} ))
            followups=""
            while :; do
              followups="$(node "$CREW_ROOT/lib/appserver-cli.mjs" followups \
                "$COMPANION_ROOT" "$PWD" "$qthread" "crew-$JOB_ID-" 2>/dev/null || true)"
              got=$(grep -c "^\[crew-$JOB_ID-" <<<"$followups" || true)
              [[ "$got" -ge "$expected" ]] && break
              if [[ $(date +%s) -ge $grace_deadline ]]; then
                # Out of patience: take whatever the turn has said so far rather
                # than reporting nothing, and let the count show it is partial.
                followups="$(node "$CREW_ROOT/lib/appserver-cli.mjs" followups --any-phase \
                  "$COMPANION_ROOT" "$PWD" "$qthread" "crew-$JOB_ID-" 2>/dev/null || true)"
                got=$(grep -c "^\[crew-$JOB_ID-" <<<"$followups" || true)
                break
              fi
              sleep "${CREW_CODEX_POLL_SECS:-5}"
            done
            if [[ -n "$followups" ]]; then
              printf '\n--- queued follow-ups ---\n%s\n' "$followups" \
                >>"$CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
              echo "QUEUED-REPLIES $got/$expected captured | appended to $CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
            else
              echo "QUEUED-REPLIES 0/$expected | the queued turn did not run before the job's runtime went away; resume the thread to deliver it" >&2
            fi
          fi
        fi

        if [[ "$jstatus" == "cancelled" ]]; then
          successor="$(crew_successor "$JOB_ID")"
          if [[ -n "$successor" ]]; then
            echo "SUPERSEDED $JOB_ID -> $successor | redirected onto the same Codex thread; await the NEW id"
            exit 4
          fi
        fi
        # Terminal: the job's broker has nothing left to serve, and each one
        # holds a codex app-server, so it is retired here rather than left to a
        # later sweep.
        side="$(crew_sidecar "$JOB_ID")"
        if [[ -f "$side" ]]; then
          IFS=$'\t' read -r _ep bpid bdir _bcwd bstart _brest <"$side" || true
          if crew_kill_broker "$bpid" "$bdir" "$bstart"; then
            crew_drop_sidecar "$JOB_ID"
          fi
        fi

        echo "DONE $jstatus | ${jelapsed} | archived: $CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
        if [[ "$jstatus" == "completed" ]]; then exit 0; fi
        exit 1
        ;;
      *)
        # Tolerate a couple of transient unreadable snapshots (state.json is
        # rewritten in place) before declaring the job genuinely gone.
        missing_streak=$(( missing_streak + 1 ))
        if [[ $missing_streak -ge 3 ]]; then
          echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
          exit 2
        fi
        ;;
    esac

    remaining=$(( deadline - $(date +%s) ))
    if [[ $remaining -le 0 ]]; then
      echo "RUNNING | ${jelapsed} | last: ${jlast}"
      exit 10
    fi

    # Prefer waiting on the job's own process: tail --pid blocks in the kernel
    # and wakes the instant it exits (verified: state.json is already terminal
    # by then). Falls back to polling when the pid is absent or already gone.
    if [[ "$jpid" =~ ^[0-9]+$ ]] && kill -0 "$jpid" 2>/dev/null; then
      stale_streak=0
      timeout "$remaining" tail --pid="$jpid" -f /dev/null 2>/dev/null || true
    else
      if [[ "$jpid" =~ ^[0-9]+$ ]]; then
        # Process is gone but the job never reached a terminal status — this is
        # the signature of a silent death, so say so instead of waiting it out.
        stale_streak=$(( stale_streak + 1 ))
        if [[ $stale_streak -ge 3 ]]; then
          echo "STALE $JOB_ID | ${jelapsed} | process $jpid is gone but status is still '$jstatus' — the job died without reporting; resume it or re-dispatch" >&2
          exit 3
        fi
      fi
      sleep "$POLL_SECS"
    fi
  done
fi

if [[ "${1:-}" == "reap" ]]; then
  crew_reap_brokers
  live=0
  for f in "$CREW_ARCHIVE_DIR"/*.broker; do
    [[ -f "$f" ]] && live=$((live + 1))
  done
  echo "REAPED | $live job broker(s) still held by running jobs"
  exit 0
fi

# ---- launch flags: --skill <name>, --network, --no-requirements -------------
# Stripped before forwarding; the companion has no such flags. Validated here,
# at the cwd the worker will actually run in, before a job or broker exists.
# Parsing follows the companion's own: `--` ends the options, and the value of a
# value option (--model, --cwd ...) is that value even when it looks like a flag,
# so prompt text such as "--network" grants nothing.
CREW_SKILLS=() CREW_NETWORK="false" CREW_NO_REQ="" CREW_SPEC_RESUME_THREAD="" CREW_TURN_SPEC_FILE="" CREW_TURN_SPEC_OWNED=""
CREW_FOREGROUND=""
case "${1:-}" in
  task|review|adversarial-review)
    fwd=("$1") want_cwd="$PWD" resuming="" asked="" stripped="" background="" cmd="$1"; shift
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --) fwd+=("$@"); break ;;
        --skill)
          if [[ -z "${2:-}" || "$2" == --* ]]; then
            echo "crew-codex: --skill needs a skill name" >&2; exit 2
          fi
          CREW_SKILLS+=("$2"); asked=1; stripped=1; shift 2 ;;
        --skill=*) CREW_SKILLS+=("${1#--skill=}"); asked=1; stripped=1; shift ;;
        --network) CREW_NETWORK="true"; asked=1; stripped=1; shift ;;
        --no-requirements) CREW_NO_REQ=1; stripped=1; shift ;;
        --cwd|-C) want_cwd="${2:-$PWD}"; fwd+=("$1"); [[ $# -gt 1 ]] && { fwd+=("$2"); shift; }; shift ;;
        --cwd=*) want_cwd="${1#--cwd=}"; fwd+=("$1"); shift ;;
        --model|-m|--effort|--prompt-file) fwd+=("$1"); [[ $# -gt 1 ]] && { fwd+=("$2"); shift; }; shift ;;
        --resume-last|--resume) resuming=1; fwd+=("$1"); shift ;;
        --resume-last=*|--resume=*) [[ "${1#*=}" == "false" ]] || resuming=1; fwd+=("$1"); shift ;;
        --background|--background=*) [[ "$1" == "--background=false" ]] || background=1; fwd+=("$1"); shift ;;
        *) fwd+=("$1"); shift ;;
      esac
    done
    # The companion splits a lone argument as a raw command line. Once a flag of
    # ours is stripped, a prompt left alone would be reparsed and a flag-shaped
    # word in it honored, so mark it as text.
    if [[ -n "$stripped" && ${#fwd[@]} -eq 2 && "${fwd[1]}" != -* ]]; then
      fwd=("${fwd[0]}" -- "${fwd[1]}")
    fi
    set -- "${fwd[@]}"
    if [[ -n "$asked" && "$cmd" != "task" ]]; then
      echo "crew-codex: --skill/--network apply to \`task\` only. Native $cmd (review/start) accepts no skill input and runs read-only without network, so it cannot carry them; launch the governing review as a \`task\` instead." >&2
      exit 2
    fi
    # A resumed thread keeps the requirements of the job the companion will
    # resume unless this launch restates them (a restated set replaces them) or
    # --no-requirements drops them.
    if [[ -n "$resuming" && -z "$asked" && -z "$CREW_NO_REQ" && "$cmd" == "task" ]]; then
      resume_pair="$(crew_resume_job "$want_cwd")" || exit 1
      resume_job="${resume_pair%%$'\t'*}" resume_thread="${resume_pair#*$'\t'}"
      if [[ -n "$resume_job" ]]; then
        # The companion selects its resume target again at run time. Bind what is
        # validated here to this thread so a changed target holds instead of
        # running under another thread's skill and network.
        if [[ "$resume_thread" =~ ^[A-Za-z0-9._-]+$ ]]; then
          CREW_SPEC_RESUME_THREAD="$resume_thread"; asked=1
        else
          echo "crew-codex: cannot bind $resume_job's requirements to a thread (companion reported '${resume_thread}'); refusing to resume" >&2; exit 1
        fi
        inherited="$(crew_job_spec "$resume_job")" || exit 1
        if [[ -n "$inherited" ]]; then
          names_out="$(crew_spec_names "$inherited")" && CREW_NETWORK="$(crew_spec_network "$inherited")" \
            || { echo "crew-codex: requirements of $resume_job are unreadable; refusing to resume without them" >&2; exit 1; }
          CREW_SKILLS=(); [[ -n "$names_out" ]] && mapfile -t CREW_SKILLS <<<"$names_out"
          asked=1
          echo "crew-codex: resuming with $resume_job's requirements (skills: ${CREW_SKILLS[*]:-none}; network: $CREW_NETWORK); pass --no-requirements to drop them" >&2
        fi
      fi
    fi
    if [[ -n "$asked" ]]; then
      if ! crew_prepare_turn_spec "$want_cwd" "$CREW_NETWORK" "${CREW_SKILLS[@]}"; then
        exit 1
      fi
      CREW_TURN_SPEC_OWNED=1
      export CREW_CODEX_TURN_SPEC="$CREW_TURN_SPEC_FILE"
      # A foreground run prints the model's answer, not a job id; the patched
      # companion names the thread it ran on instead.
      if [[ -z "$background" ]]; then CREW_FOREGROUND=1; fi
    fi
    ;;
esac

TMP_OUT="$(mktemp)" TMP_ERR="$(mktemp)"
crew_arm_cleanup

# A launch gets its own broker so it can never be pushed onto a private
# app-server; every later call for that job is routed back to the same one.
CREW_SPAWNED_ENDPOINT="" CREW_SPAWNED_PID="" CREW_SPAWNED_DIR="" CREW_HELD_LOCK=""
case "${1:-}" in
  task|review|adversarial-review)
    if [[ -z "${CREW_CODEX_NO_JOB_BROKER:-}" && -z "${!CREW_BROKER_ENV:-}" ]]; then
      crew_reap_brokers || true
      # Only detached launches take the lock: they return in seconds. A
      # foreground launch holds for the whole job, which would serialise the
      # fleet, so it stays unlocked and can still race a redirect.
      if [[ " $* " == *" --background "* ]]; then
        crew_lock_acquire
        CREW_HELD_LOCK=1
      fi
      if crew_spawn_job_broker "$PWD"; then
        export CODEX_COMPANION_APP_SERVER_ENDPOINT="$CREW_SPAWNED_ENDPOINT"
      else
        # Degrading quietly here recreates the exact failure this exists to
        # prevent: the job runs on a private app-server nothing can reach.
        echo "crew-codex: could not start a per-job broker; this job may be unreachable to steer/queue/cancel if another job holds the shared broker" >&2
      fi
    fi
    ;;
  status|result|cancel)
    for arg in "$@"; do
      if [[ "$arg" =~ ^(task|review|adversarial-review)-[a-z0-9]+-[a-z0-9]+$ ]]; then
        ep="$(crew_job_endpoint "$arg")"
        [[ -n "$ep" ]] && export CODEX_COMPANION_APP_SERVER_ENDPOINT="$ep"
        break
      fi
    done
    ;;
esac

# Bounded retry on model-capacity rejection. The capacity error is an
# admission-time rejection (the turn never starts), so retrying is write-safe.
# Jittered backoff so parallel fan-outs don't thundering-herd the quota window.
# Overridable for tests: CREW_CODEX_RETRY_DELAYS="0 0" collapses the waits.
RETRY_DELAYS=(${CREW_CODEX_RETRY_DELAYS:-5 15 45})
MAX_ATTEMPTS=$(( ${#RETRY_DELAYS[@]} + 1 ))
CAPACITY_PATTERN="at capacity"

attempt=1
while :; do
  rc=0
  node "$COMPANION" "$@" >"$TMP_OUT" 2>"$TMP_ERR" || rc=$?

  if [[ $rc -eq 0 ]] || ! grep -qi "$CAPACITY_PATTERN" "$TMP_OUT" "$TMP_ERR"; then
    break
  fi

  if [[ $attempt -ge $MAX_ATTEMPTS ]]; then
    echo "crew-codex: model still at capacity after $MAX_ATTEMPTS attempts — giving up" >&2
    break
  fi

  base=${RETRY_DELAYS[$((attempt - 1))]}
  delay=$(( base + (base > 0 ? RANDOM % (base / 2 + 1) : 0) ))
  echo "crew-codex: model at capacity (attempt $attempt/$MAX_ATTEMPTS); retrying in ${delay}s" >&2
  sleep "$delay"
  attempt=$((attempt + 1))
done

cat "$TMP_OUT"
cat "$TMP_ERR" >&2

# Tie the spec to the job id so redirect and --resume-last can continue it. A
# launch that never produced a job leaves nothing worth keeping.
if [[ -n "$CREW_TURN_SPEC_OWNED" ]]; then
  spec_job=""
  if [[ -n "$CREW_FOREGROUND" ]]; then
    # The companion recorded the job's thread; the job that owns that thread is
    # this run's. Neither stdout nor a count of new jobs is consulted.
    run_thread="$(cat "$CREW_TURN_SPEC_FILE.thread" 2>/dev/null || true)"
    [[ -n "$run_thread" ]] && spec_job="$(crew_thread_job "$run_thread")"
    # A turn that ended failed or interrupted still left a resumable thread. Only
    # a run that never reached a thread (admission failure) has nothing to record.
    if [[ -n "$run_thread" && -z "$spec_job" ]]; then
      echo "crew-codex: could not match this foreground task to its recorded job (thread ${run_thread:-unknown}), so its skill/network requirements are not recorded for --resume-last; restate --skill/--network when resuming" >&2
    fi
  else
    spec_job="$(grep -oE '\b(task|review|adversarial-review)-[a-z0-9]+-[a-z0-9]+\b' "$TMP_OUT" | head -1 || true)"
  fi
  if [[ -n "$spec_job" && ( $rc -eq 0 || -n "$CREW_FOREGROUND" ) ]]; then
    printf '%s\n' "$CREW_TURN_SPEC_FILE" >"$(crew_turn_sidecar "$spec_job")"
  else
    rm -f "$CREW_TURN_SPEC_FILE" 2>/dev/null || true
  fi
  rm -f "$CREW_TURN_SPEC_FILE.thread" 2>/dev/null || true
  CREW_TURN_SPEC_OWNED=""
fi

# Tie the broker we started to the job id the launch just printed. No job id
# means the launch failed, and an unreferenced broker is exactly the leak we
# cannot afford, so it goes now.
if [[ -n "$CREW_SPAWNED_PID" ]]; then
  launched_id="$(grep -oE '\b(task|review|adversarial-review)-[a-z0-9]+-[a-z0-9]+\b' "$TMP_OUT" | head -1 || true)"
  if [[ -n "$launched_id" && $rc -eq 0 ]]; then
    if crew_publish_sidecar "$launched_id"; then
      # Ownership is published, so cleanup must stop treating it as a leak.
      CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    else
      # The job is live. Killing its broker now would disconnect it, so keep
      # the broker and say what is unrouted; the sweep retires it later.
      echo "crew-codex: job $launched_id started but its broker could not be recorded; steer/queue will not route to it (endpoint $CREW_SPAWNED_ENDPOINT)" >&2
      CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    fi
    CREW_SPAWNED_PID=""
    if [[ -n "$CREW_HELD_LOCK" ]]; then crew_lock_release; CREW_HELD_LOCK=""; fi
    # A foreground launch has already finished by the time it returns, so its
    # broker has nothing left to serve and goes now rather than at the next
    # sweep.
    if [[ " $* " != *" --background "* ]]; then
      side="$(crew_sidecar "$launched_id")"
      IFS=$'\t' read -r _fe fbpid fbdir _fcwd fbstart _frest <"$side" || true
      if crew_kill_broker "$fbpid" "$fbdir" "$fbstart"; then
        crew_drop_sidecar "$launched_id"
      fi
    fi
  else
    crew_kill_broker "$CREW_SPAWNED_PID" "$CREW_SPAWNED_DIR" "$CREW_SPAWNED_START" || true
    CREW_SPAWNED_PID="" CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    if [[ -n "$CREW_HELD_LOCK" ]]; then crew_lock_release; CREW_HELD_LOCK=""; fi
  fi
fi

# A cancelled job is finished, so its broker goes with it. Only on success:
# a cancel that failed (wrong cwd, transient RPC error) leaves the worker
# running, and tearing its broker down would disconnect a live job for good.
if [[ "${1:-}" == "cancel" && $rc -eq 0 ]]; then
  for arg in "$@"; do
    if [[ "$arg" =~ ^(task|review|adversarial-review)-[a-z0-9]+-[a-z0-9]+$ ]]; then
      side="$(crew_sidecar "$arg")"
      if [[ -f "$side" ]]; then
        IFS=$'\t' read -r _ep bpid bdir _bcwd bstart _brest <"$side" || true
        if crew_kill_broker "$bpid" "$bdir" "$bstart"; then
          crew_drop_sidecar "$arg"
        fi
      fi
      break
    fi
  done
fi

# Same cwd trap on status/result/cancel: the companion says "not found" when
# the call comes from a directory other than the one the job was launched from.
if [[ $rc -ne 0 ]] && grep -qi "not found" "$TMP_OUT" "$TMP_ERR"; then
  for arg in "$@"; do
    if [[ "$arg" =~ ^(task|review|adversarial-review)-[a-z0-9]+-[a-z0-9]+$ ]]; then
      hint="$(crew_cwd_hint "$arg")"
      if [[ -n "$hint" ]]; then
        echo "crew-codex: job $arg${hint}" >&2
      fi
      break
    fi
  done
fi

exit $rc
