#!/usr/bin/env bash
# crew-codex — forward to the official codex plugin's companion runtime.
# Resolves the runtime through installed_plugins.json so version bumps of
# codex@openai-codex never break the crew agents.
set -euo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
INSTALLED_JSON="$CLAUDE_DIR/plugins/installed_plugins.json"
CODEX_PLUGIN_ID="codex@openai-codex"

if ! command -v node >/dev/null 2>&1; then
  echo "crew-codex: node is required (the codex companion runtime is a Node script)" >&2
  exit 1
fi

if [[ ! -f "$INSTALLED_JSON" ]]; then
  echo "crew-codex: $INSTALLED_JSON not found — install the official Codex plugin first: /plugin install $CODEX_PLUGIN_ID" >&2
  exit 1
fi

if ! COMPANION_ROOT="$(node -e '
  const fs = require("fs");
  const data = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  const entries = (data.plugins || {})[process.argv[2]];
  if (!Array.isArray(entries) || entries.length === 0 || !entries[0].installPath) process.exit(2);
  process.stdout.write(entries[0].installPath);
' "$INSTALLED_JSON" "$CODEX_PLUGIN_ID")"; then
  echo "crew-codex: $CODEX_PLUGIN_ID is not installed — run: /plugin install $CODEX_PLUGIN_ID" >&2
  exit 1
fi

COMPANION="$COMPANION_ROOT/scripts/codex-companion.mjs"
if [[ ! -f "$COMPANION" ]]; then
  echo "crew-codex: companion script missing at $COMPANION — the codex plugin layout changed; update codex-crew's resolver" >&2
  exit 1
fi

# Job state must land in the codex plugin's data dir so /codex:status,
# /codex:result and its SessionEnd cleanup see crew-launched jobs too.
export CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-$CLAUDE_DIR/plugins/data/codex-openai-codex}"

# Our own archive — the companion prunes at 50 jobs (deleting logs) and drops
# a session's jobs at SessionEnd, so results are copied somewhere it can't reap.
CREW_ARCHIVE_DIR="${CREW_CODEX_ARCHIVE_DIR:-$CLAUDE_DIR/plugins/data/codex-crew/jobs}"

# The companion keys job state to a hash of the shell's cwd, and Claude Code
# resets the cwd between Bash calls, so a job launched from one directory is
# invisible to a call made from another. Keying stays as it is; we just refuse
# to report a live job as gone. On "not found", probe the sibling state
# directories under the same parent and name the cwd to re-run from.
crew_cwd_hint() {
  local job="$1" f jcwd
  for f in "$CLAUDE_PLUGIN_DATA"/state/*/jobs/"$job".json; do
    [[ -f "$f" ]] || continue
    jcwd="$(node -e '
      const fs = require("fs");
      try {
        const j = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String((j.request && j.request.cwd) || j.workspaceRoot || ""));
      } catch (e) {}
    ' "$f" 2>/dev/null || true)"
    if [[ "$jcwd" == "$PWD" ]]; then continue; fi
    if [[ -n "$jcwd" ]]; then
      printf '; job exists under cwd %s; re-run from that directory' "$jcwd"
    else
      printf '; job exists in state dir %s; re-run from the directory it was launched from' \
        "$(dirname "$(dirname "$f")")"
    fi
    return 0
  done
  return 0
}

# One read of a job's state file, as TSV:
#   FOUND|MISSING, status, threadId, cwd, model, effort, write, newest-or-id
# "newest" reports whether this is the most recent task job for its cwd, which
# is what --resume-last would pick up.
crew_job_meta() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [dataDir, jobId] = process.argv.slice(1);
    const stateRoot = path.join(dataDir, "state");
    const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
    let dirs = [];
    try { dirs = fs.readdirSync(stateRoot); } catch { }
    for (const d of dirs) {
      const jobsDir = path.join(stateRoot, d, "jobs");
      const file = path.join(jobsDir, `${jobId}.json`);
      if (!fs.existsSync(file)) continue;
      const job = read(file);
      if (!job) continue;
      const cwd = (job.request && job.request.cwd) || job.workspaceRoot || "";
      let newest = jobId, newestAt = "";
      for (const f of fs.readdirSync(jobsDir)) {
        if (!f.endsWith(".json")) continue;
        const other = read(path.join(jobsDir, f));
        if (!other || !String(other.id || "").startsWith("task-")) continue;
        const at = String(other.createdAt || "");
        if (at > newestAt) { newestAt = at; newest = other.id; }
      }
      const req = job.request || {};
      process.stdout.write([
        "FOUND", job.status || "?", job.threadId || "", cwd,
        req.model || "", req.effort || "", req.write ? "true" : "false",
        newest === jobId ? "newest" : newest, job.turnId || ""
      ].join("\t"));
      process.exit(0);
    }
    process.stdout.write("MISSING\t\t\t\t\t\t\t\t");
  ' "$CLAUDE_PLUGIN_DATA" "$1" 2>/dev/null || printf 'MISSING\t\t\t\t\t\t\t\t'
}

# A redirect cancels the old job and resumes its Codex thread under a NEW job
# id. An agent still awaiting the old id would otherwise read that cancellation
# as failure, so name the successor: same threadId, created later.
crew_successor() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [dataDir, jobId] = process.argv.slice(1);
    const stateRoot = path.join(dataDir, "state");
    const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
    let dirs = [];
    try { dirs = fs.readdirSync(stateRoot); } catch { }
    for (const d of dirs) {
      const jobsDir = path.join(stateRoot, d, "jobs");
      const self = read(path.join(jobsDir, `${jobId}.json`));
      if (!self) continue;
      if (!self.threadId) process.exit(0);
      const mine = String(self.createdAt || "");
      let best = "", bestAt = "";
      for (const f of fs.readdirSync(jobsDir)) {
        if (!f.endsWith(".json") || f === `${jobId}.json`) continue;
        const other = read(path.join(jobsDir, f));
        if (!other || other.threadId !== self.threadId) continue;
        const at = String(other.createdAt || "");
        if (at > mine && at > bestAt) { bestAt = at; best = other.id; }
      }
      if (best) process.stdout.write(best);
      process.exit(0);
    }
  ' "$CLAUDE_PLUGIN_DATA" "$1" 2>/dev/null || true
}

if [[ "${1:-}" == "--resolve" ]]; then
  echo "$COMPANION"
  exit 0
fi

# ---- patch: teach the installed codex plugin to accept a queued message -----
# Every user installs their own copy of codex@openai-codex, at whatever version
# they happen to be on, so we carry the fix as a patch and apply it to the tree
# we resolve rather than pinning a version. Context matching (fuzz 3) absorbs
# the line drift between plugin releases; a release that moves the code out from
# under the patch fails loudly instead of half-applying.
CREW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CREW_PATCH_FILE="${CREW_CODEX_PATCH_FILE:-$CREW_ROOT/patches/codex-plugin-queue-passthrough.patch}"

crew_patch_state() {
  # applied | appliable | stale
  if patch -p1 -R --dry-run -s -F3 -d "$COMPANION_ROOT" <"$CREW_PATCH_FILE" >/dev/null 2>&1; then
    echo applied
  elif patch -p1 --dry-run -s -F3 -d "$COMPANION_ROOT" <"$CREW_PATCH_FILE" >/dev/null 2>&1; then
    echo appliable
  else
    echo stale
  fi
}

if [[ "${1:-}" == "patch" ]]; then
  shift
  ACTION="status"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) ACTION="apply"; shift ;;
      --revert) ACTION="revert"; shift ;;
      --status) ACTION="status"; shift ;;
      *) shift ;;
    esac
  done

  if ! command -v patch >/dev/null 2>&1; then
    echo "crew-codex: GNU patch is required to manage the codex plugin patch" >&2
    exit 1
  fi
  if [[ ! -f "$CREW_PATCH_FILE" ]]; then
    echo "crew-codex: patch file missing at $CREW_PATCH_FILE" >&2
    exit 1
  fi

  PLUGIN_VERSION="$(basename "$COMPANION_ROOT")"
  state="$(crew_patch_state)"

  case "$ACTION" in
    status)
      case "$state" in
        applied)   echo "PATCHED | codex plugin $PLUGIN_VERSION at $COMPANION_ROOT"; exit 0 ;;
        appliable) echo "UNPATCHED | codex plugin $PLUGIN_VERSION applies cleanly; run: crew-codex patch --apply"; exit 10 ;;
        *)         echo "crew-codex: patch does not apply to codex plugin $PLUGIN_VERSION at $COMPANION_ROOT — the upstream code moved; re-cut patches/codex-plugin-queue-passthrough.patch" >&2; exit 1 ;;
      esac
      ;;
    apply)
      if [[ "$state" == "applied" ]]; then
        echo "PATCHED | codex plugin $PLUGIN_VERSION was already patched; nothing to do"
        exit 0
      fi
      if [[ "$state" != "appliable" ]]; then
        echo "crew-codex: patch does not apply to codex plugin $PLUGIN_VERSION at $COMPANION_ROOT — refusing to half-apply; re-cut the patch against this version" >&2
        exit 1
      fi
      if ! patch -p1 -s -F3 -b --suffix=.crew-orig -d "$COMPANION_ROOT" <"$CREW_PATCH_FILE"; then
        echo "crew-codex: applying the patch failed partway; restore from the .crew-orig backups in $COMPANION_ROOT" >&2
        exit 1
      fi
      if [[ "$(crew_patch_state)" != "applied" ]]; then
        echo "crew-codex: patch reported success but verification failed; inspect $COMPANION_ROOT" >&2
        exit 1
      fi
      echo "PATCHED | codex plugin $PLUGIN_VERSION | backups: *.crew-orig | brokers already running keep the old code until their job ends"
      exit 0
      ;;
    revert)
      if [[ "$state" != "applied" ]]; then
        echo "UNPATCHED | codex plugin $PLUGIN_VERSION is not patched; nothing to revert"
        exit 0
      fi
      if ! patch -p1 -R -s -F3 -d "$COMPANION_ROOT" <"$CREW_PATCH_FILE"; then
        echo "crew-codex: reverting the patch failed; restore from the .crew-orig backups in $COMPANION_ROOT" >&2
        exit 1
      fi
      echo "UNPATCHED | codex plugin $PLUGIN_VERSION restored"
      exit 0
      ;;
  esac
fi

# ---- steer: interject into the turn a job is running right now --------------
# The primary way to correct a job in flight. Unlike interrupt, this stops
# nothing: the tool call in progress finishes, and the model reads the message
# at its next step, so it can change course before it has done all the wrong
# work. Verified: a job told to stop at file 9 of 20 read the message and
# stopped at 16, reporting "I had created exactly 16 iota files when I read
# your message." Requires the codex plugin patch (crew-codex patch --apply).
if [[ "${1:-}" == "steer" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: steer needs a job id — usage: crew-codex steer <job-id> \"<message>\"" >&2
    exit 2
  fi
  shift
  MESSAGE="$*"
  if [[ -z "$MESSAGE" ]]; then
    echo "crew-codex: steer needs the message text — usage: crew-codex steer <job-id> \"<message>\"" >&2
    exit 2
  fi

  IFS=$'\t' read -r jfound jstatus jthread jcwd _m _e _w _n jturn <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run steer from that directory" >&2
    exit 2
  fi
  if [[ "$jstatus" != "running" ]]; then
    echo "crew-codex: job $JOB_ID is $jstatus, so there is no live turn to steer; use crew-codex queue to leave a message for its next turn" >&2
    exit 2
  fi
  if [[ -z "$jthread" || -z "$jturn" ]]; then
    echo "crew-codex: job $JOB_ID has not started a turn yet; try again in a moment" >&2
    exit 2
  fi

  src=0
  steered="$(printf '%s' "$MESSAGE" | node "$CREW_ROOT/lib/appserver-cli.mjs" \
    steer "$COMPANION_ROOT" "$PWD" "$jthread" "$jturn" 2>&1)" || src=$?
  if [[ $src -ne 0 ]]; then
    echo "crew-codex: steering failed: $steered" >&2
    if grep -qiE "busy|experimentalApi" <<<"$steered"; then
      echo "crew-codex: that is the unpatched codex plugin refusing to steer — run: crew-codex patch --apply" >&2
    elif grep -qiE "no active turn|ExpectedTurnMismatch|not steerable" <<<"$steered"; then
      echo "crew-codex: the turn ended or moved on; use crew-codex queue to leave a message for the next one" >&2
    fi
    exit 1
  fi

  echo "STEERED $JOB_ID | thread $jthread | turn $jturn | the agent reads it at its next step; its reply lands in this job's own result"
  exit 0
fi

# ---- queue: say something to a running job without stopping it --------------
# The non-destructive way to change a job's course. The message waits; the
# agent reads it when it finishes the turn it is already running, so a job
# halfway through a multi-file edit lands that edit first. This is how a person
# redirects an agent, and it is the default: `redirect` interrupts, and an
# interrupt mid-edit leaves the tree half-written.
# Requires the codex plugin patch (crew-codex patch --apply).
if [[ "${1:-}" == "queue" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: queue needs a job id — usage: crew-codex queue <job-id> \"<message>\"" >&2
    exit 2
  fi
  shift
  MESSAGE="$*"
  if [[ -z "$MESSAGE" ]]; then
    echo "crew-codex: queue needs the message text — usage: crew-codex queue <job-id> \"<message>\"" >&2
    exit 2
  fi

  IFS=$'\t' read -r jfound jstatus jthread jcwd _jmodel _jeffort _jwrite _jnewest <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run queue from that directory" >&2
    exit 2
  fi
  if [[ -z "$jthread" ]]; then
    echo "crew-codex: job $JOB_ID has no Codex thread yet; wait for it to start before queueing" >&2
    exit 2
  fi
  if [[ "$jstatus" != "running" && "$jstatus" != "queued" ]]; then
    echo "crew-codex: job $JOB_ID is $jstatus, so a queued message would never be read; resume the thread instead (crew-codex redirect, or task --resume-last)" >&2
    exit 2
  fi

  mkdir -p "$CREW_ARCHIVE_DIR"
  seq_file="$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt"
  next=1
  if [[ -f "$seq_file" ]]; then
    next=$(( $(wc -l <"$seq_file") + 1 ))
  fi
  CLIENT_ID="crew-$JOB_ID-$next"

  qrc=0
  submission="$(printf '%s' "$MESSAGE" | node "$CREW_ROOT/lib/appserver-cli.mjs" \
    queue-add "$COMPANION_ROOT" "$PWD" "$jthread" "$CLIENT_ID" 2>&1)" || qrc=$?
  if [[ $qrc -ne 0 ]]; then
    echo "crew-codex: queueing failed: $submission" >&2
    if grep -qiE "busy|experimentalApi" <<<"$submission"; then
      echo "crew-codex: that is the unpatched codex plugin refusing a queued message — run: crew-codex patch --apply" >&2
    fi
    exit 1
  fi

  printf '%s\t%s\n' "$CLIENT_ID" "$MESSAGE" >>"$seq_file"
  echo "QUEUED $JOB_ID | thread $jthread | id $CLIENT_ID | the agent reads it when its current turn ends; keep awaiting"
  exit 0
fi

# ---- redirect: put a running job onto new instructions, keeping its thread --
# Codex itself can steer a turn in flight (turn/steer), but the codex plugin's
# broker forwards exactly ONE method while a turn streams: turn/interrupt
# (app-server-broker.mjs). So mid-turn steering is not reachable from here, and
# `codex queue` writes to a queue a crew job never drains. What IS reachable is
# interrupt-then-resume: cancel stops the live turn, and --resume-last picks the
# same Codex thread back up with the work so far still in context. Verified: a
# job cancelled after 4 of 30 files resumed knowing it had made exactly 4.
if [[ "${1:-}" == "redirect" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: redirect needs a job id — usage: crew-codex redirect <job-id> [--model <m>] [--effort <e>] \"<instruction>\"" >&2
    exit 2
  fi
  shift

  R_MODEL="" R_EFFORT="" INSTRUCTION=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) R_MODEL="${2:-}"; shift 2 ;;
      --effort) R_EFFORT="${2:-}"; shift 2 ;;
      *) INSTRUCTION="${INSTRUCTION:+$INSTRUCTION }$1"; shift ;;
    esac
  done

  if [[ -z "$INSTRUCTION" ]]; then
    echo "crew-codex: redirect needs the new instruction text — usage: crew-codex redirect <job-id> \"<instruction>\"" >&2
    exit 2
  fi

  # --resume-last resumes the newest task thread for THIS cwd, so the job being
  # redirected has to be that newest job or we would silently steer another one.
  IFS=$'\t' read -r jfound jstatus jthread jcwd jmodel jeffort jwrite jnewest <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run redirect from that directory so --resume-last targets its thread" >&2
    exit 2
  fi
  if [[ "$jnewest" != "newest" ]]; then
    echo "crew-codex: job $JOB_ID is not the newest task job for this cwd ($jnewest is); redirect resumes the newest thread, so cancel and re-dispatch explicitly instead" >&2
    exit 2
  fi

  if [[ "$jstatus" == "running" || "$jstatus" == "queued" ]]; then
    cancel_out="$(node "$COMPANION" cancel "$JOB_ID" 2>&1)" || true
    echo "crew-codex: interrupted $JOB_ID (was $jstatus)"
  else
    echo "crew-codex: $JOB_ID was already $jstatus; resuming its thread"
  fi

  relaunch=(task --background --resume-last)
  [[ "$jwrite" == "true" ]] && relaunch+=(--write)
  use_model="${R_MODEL:-$jmodel}"
  use_effort="${R_EFFORT:-$jeffort}"
  [[ -n "$use_model" ]] && relaunch+=(--model "$use_model")
  [[ -n "$use_effort" ]] && relaunch+=(--effort "$use_effort")
  relaunch+=("$INSTRUCTION")

  rrc=0
  relaunch_out="$(node "$COMPANION" "${relaunch[@]}" 2>&1)" || rrc=$?
  echo "$relaunch_out"
  if [[ $rrc -ne 0 ]]; then
    echo "crew-codex: redirect relaunch failed (exit $rrc); the thread is intact — resume it manually with --resume-last" >&2
    exit $rrc
  fi

  NEW_ID="$(grep -oE '\b(task|review)-[a-z0-9]+-[a-z0-9]+\b' <<<"$relaunch_out" | head -1 || true)"
  echo "REDIRECTED $JOB_ID -> ${NEW_ID:-<unknown>} | thread ${jthread:-<pending>} | await the NEW id"
  exit 0
fi

# ---- await: poll a detached job toward terminal state, token-free ----------
# Claude Code's Bash tool caps a single call at 600s, but codex jobs run for
# hours. Each await call blocks up to --for seconds (default 540, safely under
# that cap) and prints exactly ONE line; the caller loops until it stops
# reporting RUNNING. Polling happens in-shell, so a multi-hour job costs no
# model tokens while it runs. Exit: 0 completed, 1 failed/cancelled,
# 2 job not found, 3 stale, 4 superseded by a redirect, 10 still running.
if [[ "${1:-}" == "await" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: await needs a job id — usage: crew-codex await <job-id> [--for <seconds>]" >&2
    exit 2
  fi
  shift

  FOR_SECS=540
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --for) FOR_SECS="${2:-540}"; shift 2 ;;
      *) shift ;;
    esac
  done
  POLL_SECS="${CREW_CODEX_POLL_SECS:-5}"

  deadline=$(( $(date +%s) + FOR_SECS ))
  missing_streak=0
  stale_streak=0

  while :; do
    snap="$(node "$COMPANION" status "$JOB_ID" --json 2>/dev/null || true)"
    parsed="$(printf '%s' "$snap" | python3 -c '
import json, sys
try:
    j = json.load(sys.stdin)["job"]
except Exception:
    print("MISSING\t-\t-\t-\t-")
    raise SystemExit
p = j.get("progressPreview") or []
last = str(p[-1]) if p else "-"
print("\t".join([
    str(j.get("status", "?")),
    str(j.get("elapsed", "?")),
    str(j.get("logFile", "-")),
    last.replace("\t", " ")[:80],
    str(j.get("pid") or "-"),
]))
' 2>/dev/null || printf 'MISSING\t-\t-\t-\t-')"
    IFS=$'\t' read -r jstatus jelapsed jlog jlast jpid <<<"$parsed"

    case "$jstatus" in
      queued|running)
        missing_streak=0
        ;;
      completed|failed|cancelled)
        mkdir -p "$CREW_ARCHIVE_DIR"
        node "$COMPANION" result "$JOB_ID" >"$CREW_ARCHIVE_DIR/$JOB_ID.result.txt" 2>/dev/null || true
        node "$COMPANION" result "$JOB_ID" --json >"$CREW_ARCHIVE_DIR/$JOB_ID.meta.json" 2>/dev/null || true
        if [[ -f "$jlog" ]]; then
          cp -f "$jlog" "$CREW_ARCHIVE_DIR/$JOB_ID.log" 2>/dev/null || true
        fi
        # The companion closes the job at the FIRST turn/completed, so a turn
        # started from a queued message finishes outside the job record. Pull
        # those replies off the thread and append them, or the queued
        # instruction succeeds invisibly.
        if [[ -s "$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt" ]]; then
          IFS=$'\t' read -r _qf _qs qthread _rest <<<"$(crew_job_meta "$JOB_ID")"
          if [[ -n "$qthread" ]]; then
            # The job reports terminal the moment its FIRST turn ends, which is
            # before the queued turn has run. Wait for the replies we know were
            # queued rather than racing them, but stay bounded: a queued turn
            # can be lost if the worker tears down first.
            expected=$(wc -l <"$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt")
            grace_deadline=$(( $(date +%s) + ${CREW_CODEX_QUEUE_GRACE_SECS:-180} ))
            followups=""
            while :; do
              followups="$(node "$CREW_ROOT/lib/appserver-cli.mjs" followups \
                "$COMPANION_ROOT" "$PWD" "$qthread" "crew-$JOB_ID-" 2>/dev/null || true)"
              got=$(grep -c "^\[crew-$JOB_ID-" <<<"$followups" || true)
              [[ "$got" -ge "$expected" ]] && break
              if [[ $(date +%s) -ge $grace_deadline ]]; then
                # Out of patience: take whatever the turn has said so far rather
                # than reporting nothing, and let the count show it is partial.
                followups="$(node "$CREW_ROOT/lib/appserver-cli.mjs" followups --any-phase \
                  "$COMPANION_ROOT" "$PWD" "$qthread" "crew-$JOB_ID-" 2>/dev/null || true)"
                got=$(grep -c "^\[crew-$JOB_ID-" <<<"$followups" || true)
                break
              fi
              sleep "${CREW_CODEX_POLL_SECS:-5}"
            done
            if [[ -n "$followups" ]]; then
              printf '\n--- queued follow-ups ---\n%s\n' "$followups" \
                >>"$CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
              echo "QUEUED-REPLIES $got/$expected captured | appended to $CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
            else
              echo "QUEUED-REPLIES 0/$expected | the queued turn did not run before the job's runtime went away; resume the thread to deliver it" >&2
            fi
          fi
        fi

        if [[ "$jstatus" == "cancelled" ]]; then
          successor="$(crew_successor "$JOB_ID")"
          if [[ -n "$successor" ]]; then
            echo "SUPERSEDED $JOB_ID -> $successor | redirected onto the same Codex thread; await the NEW id"
            exit 4
          fi
        fi
        echo "DONE $jstatus | ${jelapsed} | archived: $CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
        if [[ "$jstatus" == "completed" ]]; then exit 0; fi
        exit 1
        ;;
      *)
        # Tolerate a couple of transient unreadable snapshots (state.json is
        # rewritten in place) before declaring the job genuinely gone.
        missing_streak=$(( missing_streak + 1 ))
        if [[ $missing_streak -ge 3 ]]; then
          echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
          exit 2
        fi
        ;;
    esac

    remaining=$(( deadline - $(date +%s) ))
    if [[ $remaining -le 0 ]]; then
      echo "RUNNING | ${jelapsed} | last: ${jlast}"
      exit 10
    fi

    # Prefer waiting on the job's own process: tail --pid blocks in the kernel
    # and wakes the instant it exits (verified: state.json is already terminal
    # by then). Falls back to polling when the pid is absent or already gone.
    if [[ "$jpid" =~ ^[0-9]+$ ]] && kill -0 "$jpid" 2>/dev/null; then
      stale_streak=0
      timeout "$remaining" tail --pid="$jpid" -f /dev/null 2>/dev/null || true
    else
      if [[ "$jpid" =~ ^[0-9]+$ ]]; then
        # Process is gone but the job never reached a terminal status — this is
        # the signature of a silent death, so say so instead of waiting it out.
        stale_streak=$(( stale_streak + 1 ))
        if [[ $stale_streak -ge 3 ]]; then
          echo "STALE $JOB_ID | ${jelapsed} | process $jpid is gone but status is still '$jstatus' — the job died without reporting; resume it or re-dispatch" >&2
          exit 3
        fi
      fi
      sleep "$POLL_SECS"
    fi
  done
fi

# Bounded retry on model-capacity rejection. The capacity error is an
# admission-time rejection (the turn never starts), so retrying is write-safe.
# Jittered backoff so parallel fan-outs don't thundering-herd the quota window.
# Overridable for tests: CREW_CODEX_RETRY_DELAYS="0 0" collapses the waits.
RETRY_DELAYS=(${CREW_CODEX_RETRY_DELAYS:-5 15 45})
MAX_ATTEMPTS=$(( ${#RETRY_DELAYS[@]} + 1 ))
CAPACITY_PATTERN="at capacity"

TMP_OUT="$(mktemp)" TMP_ERR="$(mktemp)"
trap 'rm -f "$TMP_OUT" "$TMP_ERR"' EXIT

attempt=1
while :; do
  rc=0
  node "$COMPANION" "$@" >"$TMP_OUT" 2>"$TMP_ERR" || rc=$?

  if [[ $rc -eq 0 ]] || ! grep -qi "$CAPACITY_PATTERN" "$TMP_OUT" "$TMP_ERR"; then
    break
  fi

  if [[ $attempt -ge $MAX_ATTEMPTS ]]; then
    echo "crew-codex: model still at capacity after $MAX_ATTEMPTS attempts — giving up" >&2
    break
  fi

  base=${RETRY_DELAYS[$((attempt - 1))]}
  delay=$(( base + (base > 0 ? RANDOM % (base / 2 + 1) : 0) ))
  echo "crew-codex: model at capacity (attempt $attempt/$MAX_ATTEMPTS); retrying in ${delay}s" >&2
  sleep "$delay"
  attempt=$((attempt + 1))
done

cat "$TMP_OUT"
cat "$TMP_ERR" >&2

# Same cwd trap on status/result/cancel: the companion says "not found" when
# the call comes from a directory other than the one the job was launched from.
if [[ $rc -ne 0 ]] && grep -qi "not found" "$TMP_OUT" "$TMP_ERR"; then
  for arg in "$@"; do
    if [[ "$arg" =~ ^(task|review|adversarial-review)-[a-z0-9]+-[a-z0-9]+$ ]]; then
      hint="$(crew_cwd_hint "$arg")"
      if [[ -n "$hint" ]]; then
        echo "crew-codex: job $arg${hint}" >&2
      fi
      break
    fi
  done
fi

exit $rc
