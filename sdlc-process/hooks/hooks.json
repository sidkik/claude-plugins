{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/session-start.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "sidkik-sdlc-observer",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/observer-start.sh\""
          }
        ]
      }
    ]
  }
}
